METRACARDS_API_URL=http://127.0.0.1:3001

# Firebase web config (same values as metracards-web, without VITE_ prefix)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

