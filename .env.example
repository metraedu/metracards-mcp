# Optional: override API (default is production MetraCards API)
# METRACARDS_API_URL=http://127.0.0.1:3001

# Optional: stdio credentials path (default ~/.config/metracards-mcp/credentials.json)
# METRACARDS_MCP_CREDENTIALS_PATH=

# HTTP transport (only for npm run start:http)
# METRACARDS_MCP_HTTP_HOST=127.0.0.1
# METRACARDS_MCP_HTTP_PORT=3000
# METRACARDS_MCP_RESOURCE_URL=http://127.0.0.1:3000/mcp
# METRACARDS_MCP_ISSUER_URL=http://127.0.0.1:3000
# METRACARDS_MCP_AUTH_SERVERS=
# METRACARDS_MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional OAuth DynamoDB table name (production). Leave unset for in-memory store.
# METRACARDS_MCP_OAUTH_TABLE=
