{
  "name": "metracards-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for MetraCards API",
  "bin": {
    "metracards-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/auth && cp src/auth/oauth-login-page.html dist/auth/",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "test:infra": "ts-node --project tsconfig.cdk.json --prefer-ts-exts infrastructure/test/snapshot.test.ts",
    "synth": "cdk synth",
    "deploy": "cdk deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@aws-sdk/lib-dynamodb": "^3.1101.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "hono": "^4.12.33",
    "jose": "^6.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "aws-cdk": "^2.1134.0",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.0",
    "esbuild": "^0.25.12",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
