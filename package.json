{
  "name": "metracards-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for MetraCards. Manage decks and flashcards from Cursor, Claude, and ChatGPT.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metraedu/metracards-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/metraedu/metracards-mcp/issues"
  },
  "homepage": "https://github.com/metraedu/metracards-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "metracards",
    "flashcards",
    "claude",
    "cursor"
  ],
  "bin": {
    "metracards-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/auth && cp src/auth/login-page.html src/auth/oauth-login-page.html dist/auth/",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@aws-sdk/lib-dynamodb": "^3.1101.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "hono": "^4.12.33",
    "jose": "^6.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
